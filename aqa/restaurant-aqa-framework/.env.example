# =============================================================================
# Restaurant AQA Framework — Environment Configuration Example
# Copy this file to .env and fill in your deployed environment values.
# NEVER commit .env to git.
# =============================================================================

# Frontend CloudFront URL (deployed Angular app)
FRONTEND_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net

# Backend API Gateway URL (deployed Syndicate API)
API_BASE_URL=https://xxxxxxxxxx.execute-api.eu-north-1.amazonaws.com/develop

# Default Location & Table IDs (optional; if empty, framework discovers them automatically via /locations and /available-tables)
DEFAULT_LOCATION_ID=
DEFAULT_TABLE_ID=

# Pre-existing accounts (optional; if empty, customer accounts are dynamically registered per test run)
OWNER_EMAIL=
OWNER_PASSWORD=

OTHER_CUSTOMER_EMAIL=
OTHER_CUSTOMER_PASSWORD=

# Waiter credentials (required for waiter UI/API scenarios if waiter already exists in your environment)
WAITER_EMAIL=waiter@example.com
WAITER_PASSWORD=WaiterPassword123!

# Playwright browser settings
BROWSER=chromium
HEADLESS=true
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=30000
RECORD_VIDEO=true
CAPTURE_TRACE=true
ARTIFACTS_DIR=TestResults/Artifacts

# Optional: ReportPortal integration (Bonus / Star task)
REPORT_PORTAL_ENABLED=false
REPORT_PORTAL_URL=http://localhost:8080/api/v1
REPORT_PORTAL_PROJECT=restaurant_aqa
REPORT_PORTAL_API_KEY=

